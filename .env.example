# Supabase (proyecto a nombre de Peptique) · Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# "1" para exigir sesión (cuando exista el acceso con PIN)
REQUIERE_SESION=0

# Llave para firmar las ligas de documentos al cliente (opcional; si falta se usa SUPABASE_SECRET_KEY)
DOCUMENTOS_SECRET=
